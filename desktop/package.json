{
  "name": "zibos-raid-desktop",
  "productName": "Zibo's Raid",
  "version": "0.1.0",
  "description": "Zibo's Raid: Tiny Keep - PC (Steam) surumu. Oyunun kendisi depo kokunde; bu klasor onu masaustu uygulamasina sarar.",
  "main": "main.js",
  "author": "Bora Kalkan",
  "license": "UNLICENSED",
  "scripts": { "start": "electron .", "dist": "electron-builder --win dir --x64" },
  "devDependencies": { "electron": "^31.7.7", "electron-builder": "^25.1.8" },
  "build": {
    "appId": "com.catchzibo.desktop",
    "productName": "Zibo's Raid",
    "directories": { "output": "dist" },
    "files": ["main.js", "preload.js", "game/**/*"],
    "win": { "icon": "icon.png", "target": [{ "target": "dir", "arch": ["x64"] }] }
  }
}
